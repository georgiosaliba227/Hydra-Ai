+/// Frozen vision facade: the component loader excludes language tensor namespaces
+/// before reading tensor data. No language module is constructed by this type.
+public final class MuseGlimmerFrozenVisionEncoder: Module, BaseLanguageModel {
+    @ModuleInfo(key: "vision_tower") private var tower: MuseGlimmerVisionModel
+    @ModuleInfo(key: "vision_adapter") private var adapter: MuseGlimmerVisionAdapter
+    @ModuleInfo(key: "vision_projection") private var projection: Linear
+    @ModuleInfo(key: "perception_emb_norm") private var norm: MuseRMSNormNoScale
+
+    public var excludedCheckpointNamespaces: [String] {
+        ["language_model", "model.language_model", "lm_head", "model.lm_head"]
+    }
+
+    public init(_ config: MuseGlimmerConfiguration) {
+        _tower.wrappedValue = MuseGlimmerVisionModel(config.visionConfiguration)
+        _adapter.wrappedValue = MuseGlimmerVisionAdapter(config)
+        _projection.wrappedValue = Linear(
+            config.projectorHiddenSize, config.textConfiguration.hiddenSize, bias: false)
+        _norm.wrappedValue = MuseRMSNormNoScale(eps: config.textConfiguration.rmsNormEps)
+        super.init()
+    }
+
+    public func callAsFunction(_ pixelValues: MLXArray, grid: [THW]) throws -> MLXArray {
+        let dtype = tower.patchEmbedder.patchEmbedding.weight.dtype
+        return norm(projection(adapter(tower(pixelValues.asType(dtype), grid: grid))))
+    }
+}
