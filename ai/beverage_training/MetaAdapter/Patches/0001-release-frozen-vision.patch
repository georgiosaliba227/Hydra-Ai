+    /// Release a fully evaluated, quiescent component while retaining its original
+    /// checkpoint source for the next input. Callers must have evaluated every
+    /// array that used the component and released all borrowed module references.
+    @discardableResult
+    public func releaseLoaded() -> Bool {
