# Disabled defaults. No account has authorization from this template.
# Export variables explicitly in the backend process; no dotenv loader is installed.
HYDRA_AI_MODE=mock
META_BILLABLE_REQUESTS_ENABLED=false
HYDRA_META_ACCOUNT=
# Server-only secrets; NEVER commit populated values or put provider keys in iOS.
HYDRA_META_GEORGIO_API_KEY=
HYDRA_META_AMINE_API_KEY=
HYDRA_GITHUB_NOTIFICATION_TOKEN=
# One authoritative SQLite file, with isolated account financial partitions.
HYDRA_API_TOKEN=
HYDRA_DATABASE_PATH=database/hydra.sqlite3
# guarded_meta + true alone cannot dispatch. Independent account evidence,
# immutable price review and exact-input one-request approval are mandatory.
# Legacy permits: <=$0.25. Proposed dual-test-v1 permits: <=$2 per named account.
# Neither policy authorizes spending by configuration. See docs/META_DUAL_TESTS.md.
